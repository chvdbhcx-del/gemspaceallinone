{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hovi Space",
  "version": "0.1.0",
  "identifier": "app.gemspace.allinone",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Hovi Space",
    "shortDescription": "Все аккаунты Gem Space в одном окне",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENGMkIyRTc4NTU4OTBCMTYKUldRV0M0bFZlQzRyei9sQ0JtYmdxVlhFMEQ2RENqU1ZUZ3RPWWJVdzJnam0vSmg0N09zMHBsWGUK",
      "endpoints": [
        "https://github.com/chvdbhcx-del/gemspaceallinone/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
