{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "rail",
  "description": "The account rail and settings (local UI).",
  "webviews": ["rail"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-add-account",
    "allow-update-account",
    "allow-remove-account",
    "allow-move-account",
    "allow-switch-account",
    "allow-reload-account",
    "allow-sleep-account",
    "allow-set-overlay",
    "allow-set-settings",
    "allow-hotkey"
  ]
}
