{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "accounts",
  "description": "Gem Space pages in the account webviews: only notifications and account hotkeys, nothing else.",
  "webviews": ["acc-*"],
  "remote": { "urls": ["https://web.gemspace.com/*", "https://*.gemspace.com/*"] },
  "permissions": ["allow-acc-notify", "allow-acc-hotkey"]
}
